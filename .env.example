# TaskBridge — переменные окружения
# Скопируйте в .env и при необходимости отредактируйте

# Сервер
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=TaskBridge

# База данных (путь к файлу SQLite)
DATABASE_PATH=./data.db

# JWT-секрет (ОБЯЗАТЕЛЬНО замените на случайную строку минимум 32 символа)
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING

# Администратор по умолчанию (создаётся через seed)
ADMIN_EMAIL=admin@taskbridge.local
ADMIN_PASSWORD=CHANGE_ME

# Демо-режим (true = показывать подсказку про безопасную сделку)
DEMO_MODE=true

# Загрузка файлов
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
